<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentKit.Social</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AgentKit.Social</PackageId>
    <Description>Post to social networks from a server: one channel contract (compose within each network's limits, pictures as native media with alt text or else a link card, tags, an idempotency key) and adapters for Bluesky (AT Protocol, app password, facets, images or an external card), Mastodon (instance token, Idempotency-Key, media), Discord (incoming webhook or bot channel, attachments or an embed) and X (API v2 in user context, OAuth 1.0a or OAuth 2, media). A post either lands with the network's URL and id or fails with a reason category; expected failures never throw. A retry after a lost answer re-reads before re-sending where the network allows. Credentials come from the host; the package stores nothing.</Description>
    <PackageTags>social;bluesky;atproto;mastodon;discord;webhook;x;twitter;idempotency</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentKit.Fetch\AgentKit.Fetch.csproj" />
    <!-- Channels is the lower layer: the Discord webhook reading, no-ping object, limits and cut, and the reading of an answer. -->
    <ProjectReference Include="..\AgentKit.Channels\AgentKit.Channels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentKit.Social.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
