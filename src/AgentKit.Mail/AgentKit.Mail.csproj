<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentKit.Mail</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AgentKit.Mail</PackageId>
    <Description>Send email through Resend's REST API without its SDK: one send contract (from, to, reply-to, subject, text and HTML bodies, headers, an idempotency key), a result that is sent with Resend's id or failed with a reason (auth, rate limited with the wait, rejected with Resend's message, transient), the RFC 8058 one-click unsubscribe headers, and Resend's delivery webhooks verified (Svix signatures, the Standard Webhooks scheme) and read into a small record. Expected failures never throw; the API key never reaches a log or a message. Templates, address books, suppression and preferences stay with the host.</Description>
    <PackageTags>email;resend;transactional-email;unsubscribe;rfc8058;webhooks;svix;standard-webhooks;idempotency</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentKit.Fetch\AgentKit.Fetch.csproj" />
    <!-- Channels: the reading of a status and of Retry-After, the cut, and the Standard Webhooks verifier. -->
    <ProjectReference Include="..\AgentKit.Channels\AgentKit.Channels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
