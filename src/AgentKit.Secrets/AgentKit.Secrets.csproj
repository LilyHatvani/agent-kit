<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentKit.Secrets</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AgentKit.Secrets</PackageId>
    <Description>Secrets at rest for a self-hosted service: a keyring of 32-byte master keys read from configuration (one current key that seals, older keys that only open until a rekey), each named by an id that opens nothing, and AES-256-GCM sealing with a fresh nonce and associated data that names the row, so a value copied to another row does not open. No master key: the feature that needs it is off and says so; everything else runs.</Description>
    <PackageTags>secrets;encryption;aes-gcm;key-rotation;credentials</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentKit.Secrets.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
